{
  "name": "conector-claude-antigravity",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server that keeps a Google Antigravity (agy) process warm per project, so agents like Claude Code get follow-up answers in ~2s instead of ~23s.",
  "bin": {
    "conector-claude-antigravity": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "author": "tsthas",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsthas/conector-claude-antigravity.git"
  },
  "homepage": "https://github.com/tsthas/conector-claude-antigravity#readme",
  "bugs": {
    "url": "https://github.com/tsthas/conector-claude-antigravity/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "antigravity",
    "agy",
    "claude-code",
    "gemini",
    "agent",
    "bridge"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
